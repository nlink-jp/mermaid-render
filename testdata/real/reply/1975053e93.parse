node I rect "脅威インテリジェンス照合"
node J rect "調査レポート作成"
link A -> B solid none/arrow len=1
link B -> C solid none/arrow len=1 "ドメイン名"
link B -> D solid none/arrow len=1 "IPアドレス"
link C -> E solid none/arrow len=1
link D -> F solid none/arrow len=1
link E -> G solid none/arrow len=1
link F -> H solid none/arrow len=1
link G -> I solid none/arrow len=1
link H -> I solid none/arrow len=1
link I -> J solid none/arrow len=1
