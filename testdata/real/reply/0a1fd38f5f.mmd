        date created_at
    }
    IP_ADDRESS {
        string ip PK
        string country
        boolean is_tor
    }
    ASN {
        int asn_number PK
        string org_name
    }
    THREAT_ACTOR {
        string actor_id PK
        string name
        string confidence
    }
