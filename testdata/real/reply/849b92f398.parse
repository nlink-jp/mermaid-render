dir TB
node Start stadium "調査開始"
node Input parallelogram "IP or ドメイン入力"
node CheckType rhombus "入力種別の判定" in PassiveLookup
node IPFlow rect "ASN/GeoIP/Abuse照会" in PassiveLookup
node DomainFlow rect "WHOIS/DoH/サブドメイン探索" in PassiveLookup
node ThreatIntel rect "脅威インテリジェンス照合" in PassiveLookup
node Correlate rect "相関分析 & ピボット"
node Decision rhombus "悪性判定?"
node Alert rect "インシデント報告 / 遮断対応"
node Record rect "ログ記録 & 継続監視"
node End stadium "完了"
link Start -> Input solid none/arrow len=1
link Input -> CheckType solid none/arrow len=1
link CheckType -> IPFlow solid none/arrow len=1 "IPアドレス"
link CheckType -> DomainFlow solid none/arrow len=1 "ドメイン名"
link IPFlow -> ThreatIntel solid none/arrow len=1
link DomainFlow -> ThreatIntel solid none/arrow len=1
link ThreatIntel -> Correlate solid none/arrow len=1
link Correlate -> Decision solid none/arrow len=1
link Decision -> Alert solid none/arrow len=1 "Yes"
link Decision -> Record solid none/arrow len=1 "No / 不明"
link Alert -> End solid none/arrow len=1
link Record -> End solid none/arrow len=1
subgraph PassiveLookup "パッシブ調査プロセス" [CheckType IPFlow DomainFlow ThreatIntel]
