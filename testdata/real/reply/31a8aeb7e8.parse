direction TB
start "root_start"
state "Triage"
composite "PassiveInvestigation"
    direction TB
    start "PassiveInvestigation_start"
    state "DataCollection"
    state "Pivoting"
    state "Correlation"
    end "PassiveInvestigation_end"
    "PassiveInvestigation_start" --> "DataCollection"
    "DataCollection" --> "Pivoting"
    "Pivoting" --> "Correlation"
    "Correlation" --> "PassiveInvestigation_end"
state "Closed"
state "ReportDrafting"
state "Review"
state "Published"
end "root_end"
"root_start" --> "Triage"
"Triage" --> "PassiveInvestigation" : "Valid Indicator"
"Triage" --> "Closed" : "False Positive / Out of Scope"
"PassiveInvestigation" --> "ReportDrafting" : "Evidence Collected"
"ReportDrafting" --> "Review"
"Review" --> "Published" : "Approved"
"Review" --> "PassiveInvestigation" : "Need More Evidence"
"Published" --> "root_end"
"Closed" --> "root_end"
