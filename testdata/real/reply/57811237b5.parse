dir TB
node Start rect "Investigation Start"
node InputType rhombus "Indicator Type?"
node CheckTor rect "Tor Exit Node Check"
node CheckWhois rect "WHOIS / RDAP Lookup"
node CheckASN rect "ASN & GeoIP Resolution"
node CheckAbuse rect "AbuseIPDB Reputation"
node ResolveDNS rect "DNS Resolution / DoH"
node SubdomainEnum rect "Subdomain & CNAME Enum"
node ThreatIntel rect "OTX / TI Indicator Match"
node Report rect "Generate Attribution Report"
link Start -> InputType solid none/arrow len=1
link InputType -> CheckTor solid none/arrow len=1 "IP Address"
link InputType -> CheckWhois solid none/arrow len=1 "Domain"
link CheckTor -> CheckASN solid none/arrow len=1
link CheckASN -> CheckAbuse solid none/arrow len=1
link CheckWhois -> ResolveDNS solid none/arrow len=1
link ResolveDNS -> SubdomainEnum solid none/arrow len=1
link CheckAbuse -> ThreatIntel solid none/arrow len=1
link SubdomainEnum -> ThreatIntel solid none/arrow len=1
link ThreatIntel -> Report solid none/arrow len=1
